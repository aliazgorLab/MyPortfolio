# ==============================================================================
# Portfolio CMS Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co
# Legacy/Next alias compatibility:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (Safe for public read queries)
SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (Bypasses RLS - FOR BACKEND USE ONLY)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Administrator Identity Mapping
ADMIN_ID=admin
ADMIN_EMAIL=ali.azgor.0810@gmail.com

