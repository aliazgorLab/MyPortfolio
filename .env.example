SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZuZnp1Zmtmdm1sZ3drYXR0em1oIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MzM1OTkxNywiZXhwIjoyMTA4OTM1OTE3fQ.Q9cQsBSKeWc4iqIXNbtYkc5P3RTV3_ZTU-EsAZSV3Ng
