# ==============================================================================
# Supabase Configuration for Md Ali Azgor Portfolio CMS
# ==============================================================================
# Copy this file to .env.local and fill in your Supabase credentials:
# cp .env.example .env.local
#
# IMPORTANT:
# - NEVER commit .env.local to git.
# - NEXT_PUBLIC_* variables are exposed to the browser client.
# - SUPABASE_SERVICE_ROLE_KEY is STRICTLY server-only. NEVER prefix with NEXT_PUBLIC.
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://vnfzufkfvmllgwkatzmh.supabase.co

# Supabase Anon / Public Key (From Supabase Dashboard -> Project Settings -> API)
# Safe for client-side use with Row Level Security (RLS) enabled
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZuZnp1Zmtmdm1sZ3drYXR0em1oIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMzNTk5MTcsImV4cCI6MjEwODkzNTkxN30.HlkupBAcxJFelVSZ2A7SLK9pCw4BRn7yWWhr-0vbbz4

# Supabase Service Role Key (From Supabase Dashboard -> Project Settings -> API)
