{
  "name": "my-portfolio-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Md Ali Azgor — Personal Portfolio CMS & Admin Dashboard Monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --workspace=frontend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:backend": "npm --workspace=backend run dev",
    "build": "npm --workspace=frontend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "start": "npm --workspace=frontend run start",
    "start:backend": "npm --workspace=backend run start",
    "test:security": "npm --workspace=backend run test:security"
  }
}
